# Archives générées
*.zip
*.tar.gz
*.tgz
*.rar

# Byte-compiled / Python cache
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/

# Environnements virtuels
.venv/
venv/
env/

# Fichiers temporaires et logs
*.log
*.tmp
*.bak
.DS_Store

# Fichiers de configuration sensibles contenant des mots de passe réels
# (Conserver uniquement les fichiers *.example ou *.template)
*.conf.local
*.secret

# Suite de tests (nginx-tools-tests/) : configuration nginx PRIVÉE (copie locale ou NGINX_ODOO_DIR), journaux locaux des passages
# (les exécutables de nginx-tools-tests/tools/ sont dans le dépôt depuis run-all 1.189)
nginx-tools-tests/nginx-odoo/
nginx-tools-tests/last-*.log
