# Fichier de configuration de host-perf-audit.py (exemple : toutes les clés, en commentaire = valeur par défaut).
# Configuration file of host-perf-audit.py (example: every key, commented out = default value).
# Les fichiers suivants sont LUS DANS CET ORDRE (le dernier l'emporte) ; la ligne de commande est prioritaire sur les fichiers :
#   1. /etc/default/host-perf-audit.conf    (fichier du système)
#   2. ~/.host-perf-audit.conf               (s'il existe : réglages de l'utilisateur)
# -c/--config FICHIER : ce fichier SEUL. Le programme affiche toujours quel(s) fichier(s) il lit, puis une ligne résumant les options importantes.
# Format : CLÉ=valeur, une par ligne ; # = commentaire ; guillemets facultatifs. Ce fichier est LU, jamais exécuté.

# --- Langue d'affichage ---
# en, fr ou auto (suivre LC_ALL / LC_MESSAGES / LANG).
#LANGUAGE=auto

# --- Mesure ---
# --duration : durée de la mesure : 90 (secondes), 10m, 4h, 1h30m… (des heures pour voir les pointes de la journée : sauvegardes, heures chargées)
#DURATION=60
# --interval : secondes entre deux échantillons (vide : 5 jusqu'à 2 minutes de mesure, 15 jusqu'à 30 minutes, 60 au-delà)
#INTERVAL=
# --csv : écrire aussi chaque échantillon dans ce fichier CSV (tableur)
#CSV=
# --top : nombre d'invités (conteneurs / VM) affichés, les plus actifs sur les disques d'abord
#TOP=8
# --no-guests : ne pas mesurer chaque conteneur / VM (cgroups)
#NO_GUESTS=non
# --verbose : afficher chaque commande lancée (zpool, zfs, smartctl…)
#VERBOSE=non

# --- Options de la ligne de commande SEULEMENT (actions ou réglages ponctuels : aucune clé ici) ---
# Les voici, pour mémoire (« host-perf-audit.py --help » donne le détail). Elles se donnent sur la ligne de commande, jamais dans ce fichier.
#   --apply       Après le rapport, appliquer les réglages SANS RISQUE un par un avec confirmation (compression / atime d'un dataset ZFS, maximum de l'ARC, vm.swappiness)
#   --changelog   Affiche le journal des modifications
#   --lang en|fr  Langue d'affichage (clé LANGUAGE)
#   --report-err  Afficher à la fin un rapport d'erreurs à copier-coller
#   --version     Affiche la version et quitte
#   --yes         Avec --apply : sans question

# --- Anonymisation de l'affichage ---
# --anonymize : anonymiser ce que le programme affiche (adresses IP, courriels, identifiants, jetons) par des pseudonymes stables ; clé ANONYMIZE
# (la même clé dans app-default.conf vaut pour tous les programmes ; pour cron : --anonymize ou NGINX_TOOLS_ANONYMIZE=1).
#ANONYMIZE=non
