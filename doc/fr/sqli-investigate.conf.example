# Fichier de configuration de sqli-investigate.py (exemple : toutes les clés, en commentaire = valeur par défaut).
# Les fichiers suivants sont LUS DANS CET ORDRE (le dernier l'emporte) ; la ligne de commande est toujours prioritaire :
#   1. /etc/default/sqli-investigate.conf    (fichier du système)
#   2. ~/.sqli-investigate.conf              (s'il existe : réglages de l'utilisateur)
# -c/--config FICHIER : ce fichier SEUL. Le programme affiche toujours quel(s) fichier(s) il lit, puis un résumé des options importantes.
# Format : CLÉ=valeur, une par ligne ; # = commentaire ; guillemets facultatifs ; booléens : yes / no. Ce fichier est LU, jamais exécuté.

# --- Options (ordre alphabétique) ---
# --access-log : journaux d'accès nginx, glob (fichiers courants et rotations, .gz inclus)
#ACCESS_LOG=/var/log/nginx/*-access.log*
# --fail2ban-log : journal de fail2ban, glob (rotations incluses)
#FAIL2BAN_LOG=/var/log/fail2ban.log*
# --jail : prison fail2ban dont les bannissements sont relus et comparés aux réponses données ensuite
#JAIL=nginx-sqli
# en ou fr (suit LC_ALL / LC_MESSAGES / LANG si absent)
#LANGUAGE=fr
# --no-lookup : aucune recherche de nom DNS inverse
#NO_LOOKUP=no
# --odoo-log : journal d'Odoo ; compte les erreurs Odoo à 60 s de chaque tentative (vide : aucun journal Odoo lu)
#ODOO_LOG=
# --output : dossier des résultats, créé en mode 700 (défaut : ~/audit/sqli-investigate/AAAAMMJJ-HHMMSS)
#OUTPUT=
# --top : nombre d'adresses détaillées dans le résumé (nombre positif, défaut 20)
#TOP=20
