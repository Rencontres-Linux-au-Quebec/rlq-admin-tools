Q_DESTRUCTIVE[vapid-neutralize]=1

# 1.6: tables of the schema public that no Odoo model and no many2many field uses (copies made by hand, leftovers of an uninstalled module),
# the biggest first. They are copied by every backup of the database; --export-drop-table NAME exports one then drops it.
ORPHAN_SQL="SELECT c.relname AS table_name, pg_size_pretty(pg_total_relation_size(c.oid)) AS total_size, GREATEST(c.reltuples, 0)::bigint AS rows_estimate \
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace \
WHERE n.nspname = 'public' AND c.relkind IN ('r', 'p') \
AND c.relname NOT IN (SELECT replace(model, '.', '_') FROM ir_model) \
AND c.relname NOT IN (SELECT relation_table FROM ir_model_fields WHERE relation_table IS NOT NULL) \
AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.confrelid = c.oid AND k.conrelid <> c.oid)"
Q_SQL[orphan-tables]="${ORPHAN_SQL} ORDER BY pg_total_relation_size(c.oid) DESC LIMIT 40;"
Q_DESC_EN[orphan-tables]="Tables used by no Odoo model (hand-made copies, leftovers), biggest first"
Q_DESC_FR[orphan-tables]="Tables qu'aucun modele d'Odoo n'utilise (copies faites a la main, restes), les plus grosses d'abord"

# 1.6: scheduled actions of the backup modules made inside Odoo (auto_backup of the OCA, auto_database_backup of Cybrosys). When the backups
# are made by odoo-backup.sh, they copy the database again every day: disabled (active = false, reversible), never deleted.
BACKUP_CRONS="SELECT c.id FROM ir_cron c JOIN ir_model_data d ON d.model = 'ir.cron' AND d.res_id = c.id WHERE d.module IN ('auto_backup', 'auto_database_backup')"
Q_SQL[backup-crons]="SELECT c.id, c.cron_name::text AS cron_name, c.active, d.module, c.interval_number || ' ' || c.interval_type AS every, c.nextcall FROM ir_cron c \
JOIN ir_model_data d ON d.model = 'ir.cron' AND d.res_id = c.id WHERE d.module IN ('auto_backup', 'auto_database_backup') ORDER BY c.id;"
Q_DESC_EN[backup-crons]="Scheduled backups made inside Odoo (modules auto_backup, auto_database_backup)"
Q_DESC_FR[backup-crons]="Sauvegardes planifiees faites dans Odoo (modules auto_backup, auto_database_backup)"
Q_SQL[backup-crons-disable]="UPDATE ir_cron SET active = false WHERE id IN (${BACKUP_CRONS}) RETURNING id, cron_name::text AS cron_name, active;"
Q_DESC_EN[backup-crons-disable]="Disable the backups made inside Odoo (odoo-backup.sh makes them; reversible)"
Q_DESC_FR[backup-crons-disable]="Desactiver les sauvegardes faites dans Odoo (odoo-backup.sh les fait ; reversible)"
Q_DESTRUCTIVE[backup-crons-disable]=1
Q_SQL[backup-crons-enable]="UPDATE ir_cron SET active = true WHERE id IN (${BACKUP_CRONS}) RETURNING id, cron_name::text AS cron_name, active;"
Q_DESC_EN[backup-crons-enable]="Enable again the backups made inside Odoo"
Q_DESC_FR[backup-crons-enable]="Reactiver les sauvegardes faites dans Odoo"
Q_DESTRUCTIVE[backup-crons-enable]=1

# 1.7: read-only checks after the Odoo XSS advisory of 2026-11-23 (CVE-2026-130029, Odoo 20.0 and earlier).
# xss-content: suspicious HTML (<script, onerror=, javascript:) in the messages and chatter (mail_message.body), in the Live Chat
# (discuss_channel from 17.0, mail_channel up to 16.0) and in every stored HTML field of Odoo. The tables of the versions that do not
# exist are skipped, so the same query runs on any version. Notices give the counts, the rows give the messages.
# The pattern is written in the query: the grep of the logs (nginx, Odoo) is not part of this program.
XSS_CONTENT_SQL="$(cat <<'SQL'
DO $$
DECLARE
  r record;
  n bigint;
  total bigint := 0;
  pat constant text := '<\s*script|onerror\s*=|javascript\s*[:]';
BEGIN
  FOR r IN EXECUTE 'SELECT model, count(*) AS n FROM mail_message WHERE body ~* $1 GROUP BY model ORDER BY n DESC' USING pat LOOP
    RAISE NOTICE 'mail_message, model "%": % suspicious message(s)', r.model, r.n;
    total := total + r.n;
  END LOOP;
  IF to_regclass('public.discuss_channel') IS NOT NULL THEN
    EXECUTE 'SELECT count(*) FROM discuss_channel WHERE name::text ~* $1 OR description::text ~* $1' INTO n USING pat;
    RAISE NOTICE 'Live Chat, discuss_channel (17.0 and later): % channel(s) with a suspicious name or description', n;
    total := total + n;
  END IF;
  IF to_regclass('public.mail_channel') IS NOT NULL THEN
    EXECUTE 'SELECT count(*) FROM mail_channel WHERE name::text ~* $1 OR description::text ~* $1' INTO n USING pat;
    RAISE NOTICE 'Live Chat, mail_channel (16.0 and earlier): % channel(s) with a suspicious name or description', n;
    total := total + n;
  END IF;
  FOR r IN SELECT m.model AS model_name, f.name AS field_name, replace(m.model, '.', '_') AS table_name
           FROM ir_model_fields f JOIN ir_model m ON m.id = f.model_id
           WHERE f.ttype = 'html' AND f.store LOOP
    IF to_regclass(format('public.%I', r.table_name)) IS NOT NULL
       AND EXISTS (SELECT 1 FROM information_schema.columns c
                   WHERE c.table_schema = 'public' AND c.table_name = r.table_name AND c.column_name = r.field_name) THEN
      EXECUTE format('SELECT count(*) FROM %I WHERE CAST(%I AS text) ~* $1', r.table_name, r.field_name) INTO n USING pat;
      IF n > 0 THEN
        RAISE NOTICE 'HTML field %.%: % record(s) with a suspicious pattern', r.model_name, r.field_name, n;
        total := total + n;
      END IF;
    END IF;
  END LOOP;
  IF total = 0 THEN
    RAISE NOTICE 'Messages, Live Chat and HTML fields: no suspicious pattern found';
  ELSE
    RAISE NOTICE 'Messages, Live Chat and HTML fields: % suspicious item(s) in total (the rows below list the messages only)', total;
  END IF;
END $$;
SELECT id, model, res_id, author_id, create_date,
       left(regexp_replace(body, '\s+', ' ', 'g'), 160) AS extract
FROM mail_message
WHERE body ~* '<\s*script|onerror\s*=|javascript\s*[:]'
ORDER BY create_date DESC
LIMIT 100;
SQL
)"
Q_SQL[xss-content]="${XSS_CONTENT_SQL}"
Q_DESC_EN[xss-content]="Search messages, chatter, Live Chat and HTML fields for XSS patterns (<script, onerror=, javascript:)"
Q_DESC_FR[xss-content]="Chercher les motifs XSS (<script, onerror=, javascript:) dans les messages, le chatter, le Live Chat et les champs HTML"

# xss-persistence: what an attacker leaves behind to come back: administrators, server actions, scheduled actions, API keys, views,
# system parameters. Window of 90 days in the SQL below (change the interval here). The values of the parameters are masked (length only).
XSS_PERSISTENCE_SQL="$(cat <<'SQL'
SELECT u.id, u.login, u.active, u.create_date, u.write_date
FROM res_users u
WHERE u.create_date > now() - interval '90 days'
ORDER BY u.create_date DESC;
SELECT u.id, u.login, u.active, u.write_date
FROM res_users u
JOIN res_groups_users_rel r ON r.uid = u.id
JOIN ir_model_data d ON d.res_id = r.gid AND d.model = 'res.groups' AND d.module = 'base' AND d.name = 'group_system'
ORDER BY u.write_date DESC;
SELECT id, name, state, create_date, write_date,
       left(regexp_replace(code, '\s+', ' ', 'g'), 160) AS code_start
FROM ir_act_server
WHERE create_date > now() - interval '90 days' OR write_date > now() - interval '90 days'
ORDER BY write_date DESC
LIMIT 200;
SELECT id, cron_name::text AS cron_name, active, user_id, interval_number, interval_type, nextcall, create_date, write_date
FROM ir_cron
WHERE create_date > now() - interval '90 days' OR write_date > now() - interval '90 days'
ORDER BY write_date DESC
LIMIT 200;
SELECT id, name, user_id, create_date, expiration_date
FROM res_users_apikeys
ORDER BY create_date DESC
LIMIT 200;
SELECT id, name, model, type, active, create_date, write_date
FROM ir_ui_view
WHERE create_date > now() - interval '90 days'
   OR write_date > now() - interval '90 days'
   OR CAST(arch_db AS text) ~* '<\s*script|onerror\s*=|javascript\s*[:]'
ORDER BY write_date DESC
LIMIT 200;
SELECT key, length(value) AS length
FROM ir_config_parameter
ORDER BY key;
SQL
)"
Q_SQL[xss-persistence]="${XSS_PERSISTENCE_SQL}"
Q_DESC_EN[xss-persistence]="Look for traces left by an XSS: admins, server actions, scheduled actions, API keys, views, parameters (last 90 days)"
Q_DESC_FR[xss-persistence]="Chercher les traces laissees par un XSS : admins, actions serveur, taches planifiees, cles API, vues, parametres (90 derniers jours)"

# ---------- helpers ----------
cleanup_temp() {
  if [[ -n "$LAST_OUTFILE" ]]; then
    rm -f -- "$LAST_OUTFILE"
  fi
  LAST_OUTFILE=""
}

init_colors() {
  if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
    C_OPT=$'\e[1;36m'
    C_VER=$'\e[1;33m'
    C_ERR=$'\e[1;31m'
    C_RST=$'\e[0m'
    USE_COLOR=1
  fi
}

query_desc() {
  if [[ "$UI_LANG" == "fr" ]]; then
    printf '%s' "${Q_DESC_FR[$1]}"
  else
    printf '%s' "${Q_DESC_EN[$1]}"
  fi
}

notify() {  # notify INTERFACE TEXT
  if [[ "$1" == "dialog" ]]; then
    "$DIALOG_BIN" --msgbox "$2" 9 72 || true
  else
    printf '%s%s%s\n' "$C_ERR" "$2" "$C_RST" >&2
  fi
}

log_line() {  # log_line QUERY MODE RESULT
  [[ -n "$LOG_FILE" ]] || return 0
  printf '%s %s db=%s user=%s query=%s mode=%s result=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$PROGRAM" "$PG_DATABASE" "$PG_USER" \
    "$1" "$2" "$3" >> "$LOG_FILE" 2>/dev/null || true
}

load_config_file() {  # load_config_file PATH
  local file="$1" line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ "$line" =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value#\"}"
    value="${value%\"}"
    case "$key" in
      PG_HOST|PG_PORT|PG_USER|PG_DATABASE|DIALOG_BIN|EXPORT_DIR|LOG_FILE|PROD_PATTERN|UI_LANG)
        printf -v "$key" '%s' "$value"
        ;;
    esac
  done < "$file"
  CONFIG_FILES_READ+=("$file")
}

# Commented configuration template, written when no configuration file exists.
print_config_template() {
  cat <<'TEMPLATE'
# odoo-sql-maint configuration / configuration d'odoo-sql-maint
#
# Read at each start. Command-line options override this file.
# Lu a chaque lancement. Les options de la ligne de commande ont priorite.
#
# Passwords are NOT stored here: use ~/.pgpass (chmod 600).
# Les mots de passe ne sont PAS ici : utilisez ~/.pgpass (chmod 600).

# Target database (required). Example: odoo_dev / Base cible (obligatoire). Exemple : odoo_dev
PG_DATABASE=

PG_HOST=localhost
PG_PORT=5432
PG_USER=odoo

# Audit log of every run (empty = disabled) / Journal d'audit (vide = desactive)
LOG_FILE=

# Destructive runs on database names matching this regex need --yes
# Execution destructive sur une base dont le nom correspond a cette regex : --yes requis
PROD_PATTERN=prod

# Interface language: fr or en (empty = from LANG) / Langue : fr ou en (vide = selon LANG)
UI_LANG=

# Menu program (dialog) / Programme du menu (dialog)
DIALOG_BIN=dialog

# Folder of the exports made by --export-drop-table (created with mode 700) / Dossier des exports de --export-drop-table (cree en mode 700)
EXPORT_DIR=/var/backups/odoo-sql-maint
TEMPLATE
}

# write_config_template PATH: create PATH (and its folder) with mode 600, never overwrite.
write_config_template() {
  local file="$1" dir
  dir="$(dirname -- "$file")"
  if ! mkdir -p -- "$dir" 2>/dev/null || ! (umask 077; print_config_template > "$file") 2>/dev/null; then
    printf '%s\n' "$(t config_create_fail "$file")" >&2
    return 1
  fi
  printf '%s\n' "$(t config_created "$file")" >&2
  return 0
}

load_configuration() {
  local file found=0 default_file="$HOME/.odoo-sql-maint.conf"
  if [[ -n "$CONFIG_OVERRIDE" ]]; then
    if [[ ! -e "$CONFIG_OVERRIDE" ]]; then
      write_config_template "$CONFIG_OVERRIDE" || exit 2
    fi
    if [[ ! -r "$CONFIG_OVERRIDE" ]]; then
      printf '%s\n' "$(t no_config "$CONFIG_OVERRIDE")" >&2
      exit 2
    fi
    load_config_file "$CONFIG_OVERRIDE"
  else
    for file in /etc/default/odoo-sql-maint.conf "$default_file"; do
      if [[ -r "$file" ]]; then
        load_config_file "$file"
        found=1
      fi
    done
    # No configuration file at all: create the default one, then read it.
    if [[ "$found" -eq 0 ]] && write_config_template "$default_file"; then
      load_config_file "$default_file"
    fi
  fi
  if [[ -n "$CLI_DATABASE" ]]; then
    PG_DATABASE="$CLI_DATABASE"
  fi
  if [[ -n "$CLI_LANG" ]]; then
    UI_LANG="$CLI_LANG"
  fi
  if [[ "$VERBOSE" -eq 1 ]]; then
    printf '%s\n' "$(t config_read "${CONFIG_FILES_READ[*]:-$(t config_none)}")" >&2
  fi
}

resolve_language() {
  if [[ -z "$UI_LANG" ]]; then
    case "${LANG:-fr}" in
      en*) UI_LANG="en" ;;
      *)   UI_LANG="fr" ;;
    esac
  fi
  case "$UI_LANG" in
    fr|en) ;;
    *) UI_LANG="en" ;;
  esac
}

check_psql() {
  if ! command -v psql >/dev/null 2>&1; then
    printf '%s\n' "$(t no_psql)" >&2
    exit 3
  fi
}

check_dialog() {
  if ! command -v "$DIALOG_BIN" >/dev/null 2>&1; then
    printf '%s\n' "$(t no_dialog "$DIALOG_BIN")" >&2
    exit 3
  fi
}

# The dialog menu draws on the terminal: fail with a clear message when /dev/tty cannot be opened.
check_tty() {
  if ! { : >/dev/tty; } 2>/dev/null; then
    printf '%s\n' "$(t no_tty)" >&2
    exit 3
  fi
}

psql_base_args() {
  PSQL_ARGS=(-X -q -v ON_ERROR_STOP=1 -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" -d "$PG_DATABASE" -P pager=off)
}

# run_query NAME MODE(run|dry) OUTFILE
# Wraps the query in a transaction: COMMIT for run, ROLLBACK for dry.
run_query() {
  local name="$1" mode="$2" outfile="$3" rc
  {
    echo "BEGIN;"
    echo "${Q_SQL[$name]}"
    if [[ "$mode" == "dry" ]]; then
      echo "ROLLBACK;"
    else
      echo "COMMIT;"
    fi
  } | psql "${PSQL_ARGS[@]}" > "$outfile" 2>&1
  rc=$?
  log_line "$name" "$mode" "$rc"
  return "$rc"
}

# execute_query NAME MODE(run|dry) INTERFACE(dialog|cli)
# Returns 0 on success, 1 on SQL failure, 4 when refused or cancelled.
execute_query() {
  local name="$1" mode="$2" ui="$3" rc answer=""
  cleanup_temp

  if [[ -z "$PG_DATABASE" ]]; then
    notify "$ui" "$(t no_db)"
    return 4
  fi
  if [[ ! "$PG_DATABASE" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    notify "$ui" "$(t bad_db "$PG_DATABASE")"
    return 4
  fi

  if [[ "${Q_DESTRUCTIVE[$name]:-0}" == "1" && "$mode" == "run" ]]; then
    if [[ -n "$PROD_PATTERN" && "$ASSUME_YES" -ne 1 && "$PG_DATABASE" =~ $PROD_PATTERN ]]; then
      notify "$ui" "$(t blocked "$PG_DATABASE" "$PROD_PATTERN")"
      return 4
    fi
    if [[ "$ASSUME_YES" -ne 1 ]]; then
      if [[ "$ui" == "dialog" ]]; then
        if ! "$DIALOG_BIN" --yesno "$(t confirm "$PG_DATABASE")" 8 72; then
          notify "$ui" "$(t cancelled)"
          return 4
        fi
      elif [[ -t 0 ]]; then
        read -r -p "$(t confirm_cli "$PG_DATABASE")" answer
        if [[ "$answer" != "YES" && "$answer" != "OUI" ]]; then
          notify "$ui" "$(t cancelled)"
          return 4
        fi
      else
        notify "$ui" "$(t refused_noyes)"
        return 4
      fi
    fi
  fi

  LAST_OUTFILE="$(mktemp)"
  run_query "$name" "$mode" "$LAST_OUTFILE"
  rc=$?
  if [[ "$rc" -eq 0 ]]; then
    printf '\n%s\n' "$(t done_ok "$rc")" >> "$LAST_OUTFILE"
    return 0
  fi
  printf '\n%s\n' "$(t done_fail "$rc")" >> "$LAST_OUTFILE"
  return 1
}

# export_drop_table NAME (1.6): checks that no Odoo model uses the table, exports it with pg_dump into EXPORT_DIR (gzip checked, CREATE TABLE and
# data present), then drops it in a transaction (ROLLBACK with --dry-run). Never CASCADE: a table another one depends on is refused by PostgreSQL.
# Returns 0 when done, 1 on failure, 4 when refused or cancelled.
export_drop_table() {
  local table="$1" info size rows file answer="" rc
  if [[ -z "$PG_DATABASE" ]]; then printf '%s\n' "$(t no_db)" >&2; return 4; fi
  if [[ ! "$PG_DATABASE" =~ ^[A-Za-z0-9_.-]+$ ]]; then printf '%s\n' "$(t bad_db "$PG_DATABASE")" >&2; return 4; fi
  if [[ ! "$table" =~ ^[a-z_][a-z0-9_]{0,62}$ ]]; then printf '%s%s%s\n' "$C_ERR" "$(t bad_table "$table")" "$C_RST" >&2; return 4; fi
  if ! command -v pg_dump >/dev/null 2>&1; then printf '%s\n' "$(t no_pg_dump)" >&2; return 3; fi
  if [[ -z "$(psql "${PSQL_ARGS[@]}" -At -c "SELECT 1 FROM pg_tables WHERE schemaname = 'public' AND tablename = '$table'" 2>/dev/null)" ]]; then
    printf '%s%s%s\n' "$C_ERR" "$(t no_table "$table" "$PG_DATABASE")" "$C_RST" >&2
    return 4
  fi
  info="$(psql "${PSQL_ARGS[@]}" -At -c "SELECT string_agg(DISTINCT k.conrelid::regclass::text, ', ') FROM pg_constraint k
    WHERE k.confrelid = 'public.$table'::regclass AND k.conrelid <> k.confrelid" 2>/dev/null)"
  if [[ -n "$info" ]]; then
    printf '%s%s%s\n' "$C_ERR" "$(t referenced "$table" "$info")" "$C_RST" >&2
    return 4
  fi
  info="$(psql "${PSQL_ARGS[@]}" -At -F '|' -c "${ORPHAN_SQL} AND c.relname = '$table';" 2>/dev/null)"
  if [[ -z "$info" ]]; then
    printf '%s%s%s\n' "$C_ERR" "$(t odoo_table "$table")" "$C_RST" >&2
    return 4
  fi
  size="$(cut -d'|' -f2 <<< "$info")"; rows="$(cut -d'|' -f3 <<< "$info")"
  printf '%s\n' "$(t table_info "$table" "$PG_DATABASE" "$size" "$rows")"
  if [[ -n "$PROD_PATTERN" && "$ASSUME_YES" -ne 1 && "$PG_DATABASE" =~ $PROD_PATTERN ]]; then
    printf '%s\n' "$(t blocked "$PG_DATABASE" "$PROD_PATTERN")" >&2
    return 4
  fi
  if [[ "$ASSUME_YES" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then printf '%s\n' "$(t refused_noyes)" >&2; return 4; fi
    read -r -p "$(t confirm_drop "$EXPORT_DIR")" answer
    if [[ "$answer" != "$table" ]]; then printf '%s\n' "$(t cancelled)"; return 4; fi
  fi
  if ! (umask 077; mkdir -p -- "$EXPORT_DIR"); then printf '%s\n' "$(t export_fail "$EXPORT_DIR")" >&2; return 1; fi
  file="$EXPORT_DIR/${PG_DATABASE}-${table}-$(date '+%Y%m%d-%H%M%S').sql.gz"
  printf '%s\n' "$(t exporting "$file")"
  if ! (umask 077; pg_dump -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" -d "$PG_DATABASE" -t "public.$table" --no-owner --no-privileges | gzip -6 > "$file") \
     || ! gzip -t -- "$file" 2>/dev/null \
     || ! gzip -dc -- "$file" | grep -q "^CREATE TABLE public\.$table " \
     || ! gzip -dc -- "$file" | grep -qE "^COPY public\.$table "; then
    printf '%s%s%s\n' "$C_ERR" "$(t export_fail "$file")" "$C_RST" >&2
    log_line "export-drop-table:$table" export 1
    return 1
  fi
  printf '%s\n' "$(t export_ok "$file" "$(du -h -- "$file" | cut -f1)")"
  {
    echo "BEGIN;"
    echo "DROP TABLE public.$table;"
    if [[ "$DRY_RUN" -eq 1 ]]; then echo "ROLLBACK;"; else echo "COMMIT;"; fi
  } | psql "${PSQL_ARGS[@]}"
  rc=$?
  log_line "export-drop-table:$table" "$([[ "$DRY_RUN" -eq 1 ]] && echo dry || echo run)" "$rc"
  if [[ "$rc" -ne 0 ]]; then printf '%s%s%s\n' "$C_ERR" "$(t drop_fail "$file")" "$C_RST" >&2; return 1; fi
  if [[ "$DRY_RUN" -eq 1 ]]; then printf '%s\n' "$(t dry_drop "$table")"; else printf '%s\n' "$(t dropped "$table" "$file" "$PG_DATABASE")"; fi
  return 0
}

# dialog_run VAR ARGS...: run dialog with its screen on the terminal; its answer goes to VAR.
# The answer is written to a file (--output-fd), not captured with $(...): dialog then keeps the
# terminal as its screen and never needs to re-open a terminal by name ("cannot open tty-output").
dialog_run() {
  local __var="$1" answer rc
  shift
  answer="$(mktemp)" || return 1
  "$DIALOG_BIN" --output-fd 3 "$@" 3>"$answer"
  rc=$?
  printf -v "$__var" '%s' "$(cat -- "$answer")"
  rm -f -- "$answer"
  return "$rc"
}

run_menu() {
  local choice action name
  local -a items
  while true; do
    items=()
    for name in "${QUERY_NAMES[@]}"; do
      items+=("$name" "$(query_desc "$name")")
    done
    items+=("quit" "$(t exit)")
    dialog_run choice --title "$(t title)" \
      --menu "$(t menu "$PG_DATABASE")" 22 100 12 "${items[@]}" || break
    [[ "$choice" == "quit" ]] && break

    dialog_run action --title "$(t title)" \
      --menu "$(t action "$choice")" 12 72 3 \
      run "$(t act_run)" dry "$(t act_dry)" back "$(t act_cancel)" || continue
    [[ "$action" == "back" ]] && continue

    execute_query "$choice" "$action" dialog || true
    if [[ -n "$LAST_OUTFILE" && -s "$LAST_OUTFILE" ]]; then
      "$DIALOG_BIN" --title "$(t title)" --textbox "$LAST_OUTFILE" 22 100 || true
    fi
    cleanup_temp
  done
}

run_cli() {  # run_cli NAME
  local name="$1" mode="run" rc
  if [[ -z "${Q_SQL[$name]:-}" ]]; then
    printf '%s%s%s\n' "$C_ERR" "$(t bad_query "$name")" "$C_RST" >&2
    return 2
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    mode="dry"
  fi
  execute_query "$name" "$mode" cli
  rc=$?
  if [[ -n "$LAST_OUTFILE" && -s "$LAST_OUTFILE" ]]; then
    cat -- "$LAST_OUTFILE"
  fi
  cleanup_temp
  return "$rc"
}

list_queries() {
  local name flag line
  for name in "${QUERY_NAMES[@]}"; do
    flag=""
    if [[ "${Q_DESTRUCTIVE[$name]:-0}" == "1" ]]; then
      flag=" [$(t destructive)]"
    fi
    printf -v line '%s%-22s%s %s%s\n' "$C_OPT" "$name" "$C_RST" "$(query_desc "$name")" "$flag"
    # A closed pipe (ex. | head) is not an error: stop quietly.
    printf '%s' "$line" 2>/dev/null || return 0
  done
}

# Prints only this program's section of CHANGELOG.md ("## odoo-sql-maint"), version numbers in colour.
show_changelog() {
  local file="" candidate
  for candidate in \
    "$SCRIPT_DIR/CHANGELOG.md" \
    "/usr/local/share/doc/odoo-sql-maint/CHANGELOG.md" \
    "/usr/share/doc/odoo-sql-maint/CHANGELOG.md"; do
    if [[ -r "$candidate" ]]; then
      file="$candidate"
      break
    fi
  done
  if [[ -z "$file" ]]; then
    printf '%s\n' "$(t no_changelog)" >&2
    return 2
  fi
  # Errors from awk on a closed pipe are ignored on purpose.
  awk -v sect="## $PROGRAM" -v on="$USE_COLOR" -v ver="$C_VER" -v rst="$C_RST" '
    /^## / { show = ($0 == sect); if (!show) next }
    !show { next }
    /^### / && (on + 0) && match($0, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/) {
      printf "%s%s%s%s%s\n", substr($0, 1, RSTART - 1), ver,
        substr($0, RSTART, RLENGTH), rst, substr($0, RSTART + RLENGTH)
      next
    }
    { print }
  ' "$file" 2>/dev/null || true
}

show_help() {
  cat <<EOF
Usage / Utilisation: $PROGRAM [options]

Options (alphabetical / ordre alphabetique):
  ${C_OPT}--changelog${C_RST}        Show this program's changelog / Afficher le journal de ce programme
  ${C_OPT}--config FILE${C_RST}      Read only FILE / Lire seulement FILE
  ${C_OPT}--database NAME${C_RST}    Target database / Base cible
  ${C_OPT}--dry-run${C_RST}          With --run or --export-drop-table: roll back at the end / Avec --run ou --export-drop-table : annuler a la fin
  ${C_OPT}--export-drop-table T${C_RST} Export table T (no Odoo model uses it) to EXPORT_DIR, then drop it / Exporter la table T (aucun modele d'Odoo) dans EXPORT_DIR, puis la supprimer
  ${C_OPT}--help${C_RST}             Show this help / Afficher cette aide
  ${C_OPT}--language LANG${C_RST}    Interface language, fr or en / Langue de l'interface, fr ou en
  ${C_OPT}--list${C_RST}             List available queries / Lister les requetes
  ${C_OPT}--run NAME${C_RST}         Run one query without the menu / Executer une requete sans menu
  ${C_OPT}--verbose${C_RST}          Show the config files read / Afficher les fichiers de config lus
  ${C_OPT}--version${C_RST}          Show the version / Afficher la version
  ${C_OPT}--yes${C_RST}              Skip confirmations, for scripts / Sans confirmation, pour les scripts

Config files / Fichiers de config (later overrides earlier; command line overrides all):
  /etc/default/odoo-sql-maint.conf
  ~/.odoo-sql-maint.conf
  Key options / Options principales: PG_HOST, PG_PORT, PG_USER, PG_DATABASE (target base / base cible),
  LOG_FILE (audit log / journal d'audit), PROD_PATTERN (destructive runs need --yes / --yes requis),
  UI_LANG (fr or en), DIALOG_BIN, EXPORT_DIR (exports of --export-drop-table / exports de --export-drop-table).

$(t config_read "${CONFIG_FILES_READ[*]:-$(t config_none)}")
EOF
}

parse_args() {
  local opt val
  while [[ $# -gt 0 ]]; do
    opt="$1"
    val=""
    case "$opt" in
      --*=*)
        val="${opt#*=}"
        opt="${opt%%=*}"
        ;;
      --config|--database|--export-drop-table|--language|--run)
        if [[ $# -lt 2 ]]; then
          printf '%s\n' "$(t missing_value "$opt")" >&2
          exit 2
        fi
        val="$2"
        shift
        ;;
    esac
    case "$opt" in
      --changelog) ACTION="changelog" ;;
      --config)    CONFIG_OVERRIDE="$val" ;;
      --database)  CLI_DATABASE="$val" ;;
      --dry-run)   DRY_RUN=1 ;;
      --export-drop-table) ACTION="export-drop"; DROP_TABLE="$val" ;;
      --help)      ACTION="help" ;;
      --language)
        case "$val" in
          fr|en) CLI_LANG="$val" ;;
          *)
            printf '%s\n' "$(t bad_language "$val")" >&2
            exit 2
            ;;
        esac
        ;;
      --list)      ACTION="list" ;;
      --run)       ACTION="run"; RUN_NAME="$val" ;;
      --verbose)   VERBOSE=1 ;;
      --version)   ACTION="version" ;;
      --yes)       ASSUME_YES=1 ;;
      *)
        printf '%s\n' "$(t bad_option "$opt")" >&2
        exit 2
        ;;
    esac
    shift
  done
}

main() {
  trap cleanup_temp EXIT
  trap 'exit 0' PIPE    # quiet exit when the output pipe is closed (ex. | head)
  # 1.5: first line of EVERY run, even --help: name and version (--version prints it by itself), as the other programs do
  case " $* " in *" --version "*) ;; *) printf '%s v%s\n' "$PROGRAM" "$__version__" ;; esac

  parse_args "$@"
  init_colors

  case "$ACTION" in
    version)   printf '%s %s\n' "$PROGRAM" "$__version__"; return 0 ;;
    changelog) show_changelog; return $? ;;
  esac

  load_configuration
  resolve_language

  case "$ACTION" in
    help) show_help; return 0 ;;
    list) list_queries; return 0 ;;
  esac

  check_psql
  psql_base_args

  case "$ACTION" in
    run)  run_cli "$RUN_NAME"; return $? ;;
    export-drop) export_drop_table "$DROP_TABLE"; return $? ;;
    menu) check_dialog; check_tty; run_menu ;;
  esac
  return 0
}

main "$@"
exit $?
