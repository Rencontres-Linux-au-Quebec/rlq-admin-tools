# odoo-sql-maint - menu-driven runner for maintenance SQL queries on an Odoo PostgreSQL database.
# odoo-sql-maint - lanceur de menu pour les requetes SQL de maintenance sur une base PostgreSQL d'Odoo.
#
# Every query runs inside a transaction: COMMIT for a real run, ROLLBACK for a dry run. Destructive queries ask for
# confirmation and are refused on databases whose name matches PROD_PATTERN unless --yes is given.
#
# Config files read, in this order (the later file overrides the earlier one):
#   /etc/default/odoo-sql-maint.conf
#   ~/.odoo-sql-maint.conf
# Command-line options override both. --config FILE reads only FILE.
# Passwords are never stored in a config file: use ~/.pgpass (chmod 600).
#
# Usage / Utilisation : odoo-sql-maint [OPTION]...   (sans option : menu dialog)
#
# Options (par ordre alphabetique) : see --help / voir --help

__version__="1.3.20261028.194152"

set -u
set -o pipefail

PROGRAM="odoo-sql-maint"
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

# ---------- defaults (lowest priority) ----------
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="odoo"
PG_DATABASE=""
DIALOG_BIN="dialog"
LOG_FILE=""
UI_LANG=""
PROD_PATTERN="prod"    # regex: destructive runs on matching database names need --yes

CONFIG_FILES_READ=()
CONFIG_OVERRIDE=""
ACTION="menu"
RUN_NAME=""
ASSUME_YES=0
DRY_RUN=0
VERBOSE=0
CLI_DATABASE=""
CLI_LANG=""
LAST_OUTFILE=""
PSQL_ARGS=()
USE_COLOR=0
C_OPT=""
C_VER=""
C_ERR=""
C_RST=""

# ---------- user-visible messages (French and English) ----------
declare -A MSG_EN MSG_FR

MSG_EN[title]="Odoo SQL maintenance"
MSG_FR[title]="Maintenance SQL Odoo"
MSG_EN[menu]="Choose a query (database: %s)"
MSG_FR[menu]="Choisir une requete (base : %s)"
