msgid "Usage : nginx-log-audit.sh [dev|prod] [OPTION]..."
msgstr "Usage: nginx-log-audit.sh [dev|prod] [OPTION]..."

msgid "Rapport des journaux nginx : robots, refus, attaques, enquêtes sur les IP suspectes, bannissements."
msgstr "nginx log report: robots, refusals, attacks, investigations of suspicious IPs, bans."

msgid "  dev | prod                   environnement (journal du site) ; défaut : celui du profil détecté"
msgstr "  dev | prod                   environment (site log); default: that of the detected profile"

msgid "Options (par ordre alphabétique) :"
msgstr "Options (in alphabetical order):"

msgid "  --app NAME                   application derrière nginx (profil apps/NAME.conf : odoo, bbb…) ; détectée par défaut"
msgstr "  --app NAME                   application behind nginx (profile apps/NAME.conf: odoo, bbb…); detected by default"

msgid "  --ban IP                     bannir IP au pare-feu (preuves affichées, confirmation demandée)"
msgstr "  --ban IP                     ban IP at the firewall (evidence shown, confirmation asked)"

msgid "  --ban-threshold N            nombre d'indices à partir duquel le bannissement est proposé (défaut : 3)"
msgstr "  --ban-threshold N            number of clues from which a ban is suggested (default: 3)"

msgid "  --changelog                  affiche le journal des modifications"
msgstr "  --changelog                  show the change log"

msgid "  -c, --config FILE            fichier de configuration à lire SEUL (sinon : /etc/default/nginx-log-audit.conf, puis ~/.nginx-log-audit.cfg ;"
msgstr "  -c, --config FILE            configuration file to read ALONE (otherwise: /etc/default/nginx-log-audit.conf, then ~/.nginx-log-audit.cfg;"

msgid "                               clés : APP, BAN_THRESHOLD, LANGUAGE, NO_PROMPT, PAGE_BURST, PARALLEL_THRESHOLD, UA_ROTATION_THRESHOLD, VERBOSE)"
msgstr "                               keys: APP, BAN_THRESHOLD, LANGUAGE, NO_PROMPT, PAGE_BURST, PARALLEL_THRESHOLD, UA_ROTATION_THRESHOLD, VERBOSE)"

msgid "  --details                    avec --stats : détail de chaque indicateur"
msgstr "  --details                    with --stats: detail of each indicator"

msgid "  --evidence IP                preuves pour ou contre le bannissement d'une IP et verdict, sans rien demander ni bannir (lecture seule)"
msgstr "  --evidence IP                evidence for or against banning an IP and verdict, asking and banning nothing (read-only)"

msgid "  --export-bans [FILE]         exporter les bannissements manuels (sortie standard par défaut)"
msgstr "  --export-bans [FILE]         export the manual bans (standard output by default)"

msgid "  --fail2ban                   état des jails et historique des bannissements de fail2ban"
msgstr "  --fail2ban                   state of the jails and fail2ban ban history"

msgid "  -h, --help                   affiche cette aide et quitte"
msgstr "  -h, --help                   show this help and exit"

msgid "  --import-bans FILE|-         importer des bannissements (- : entrée standard) ; aperçu, puis confirmation"
msgstr "  --import-bans FILE|-         import bans (- : standard input); preview, then confirmation"

msgid "  --init                       analyser tout le fichier actif (et non seulement le nouveau depuis le dernier passage)"
msgstr "  --init                       analyse the whole active file (not only what is new since the last run)"

msgid "  --init-all                   analyser tout l'historique, rotations comprises"
msgstr "  --init-all                   analyse the whole history, rotations included"

msgid "  --investigate IP             enquête complète sur une IP (tout l'historique), avec le propriétaire de son bloc d'adresses (RDAP)"
msgstr "  --investigate IP             full investigation of an IP (whole history), with the owner of its address block (RDAP)"

msgid "  --ip ADDRESS                 limiter le rapport à une adresse"
msgstr "  --ip ADDRESS                 limit the report to one address"

msgid "  --lang LANG                  langue d'affichage : en ou fr (défaut : selon LC_ALL / LC_MESSAGES / LANG)"
msgstr "  --lang LANG                  display language: en or fr (default: from LC_ALL / LC_MESSAGES / LANG)"

msgid "  --last HOURS                 limiter toutes les sections aux HOURS dernières heures"
msgstr "  --last HOURS                 limit all sections to the last HOURS hours"

msgid "  --no-prompt                  ne pas proposer de bannir en fin de rapport"
msgstr "  --no-prompt                  do not offer to ban at the end of the report"

msgid "  --page-burst N               pages distinctes en 10 s à partir desquelles l'indice « rafale » est retenu"
msgstr "  --page-burst N               distinct pages in 10 s from which the « burst » clue is retained"

msgid "  --report-err                 afficher à la fin un rapport d'erreurs à copier-coller (programme, version, serveur,"
msgstr "  --report-err                 print at the end an error report to copy and paste (program, version, server,"

msgid "                               échecs, avertissements) ; désactive couleurs et questions interactives"
msgstr "                               failures, warnings); disables colours and interactive questions"

msgid "  --stats                      statistiques du trafic (codes, IP, User-Agents, appareils des visiteurs)"
msgstr "  --stats                      traffic statistics (codes, IPs, User-Agents, visitors' devices)"

msgid "  --ua-rotation-threshold N    identités de robots différentes pour l'indice « double identité »"
msgstr "  --ua-rotation-threshold N    different robot identities for the « double identity » clue"

msgid "  --unban IP                   lever un bannissement manuel"
msgstr "  --unban IP                   lift a manual ban"

msgid "  --unban-check                réévaluer chaque bannissement manuel (levée proposée si injustifié)"
msgstr "  --unban-check                re-evaluate each manual ban (lifting suggested if unjustified)"

msgid "  -v, --verbose                affiche chaque commande lancée"
msgstr "  -v, --verbose                show every command run"

msgid "  --version                    affiche la version et quitte"
msgstr "  --version                    show the version and exit"

msgid "  --yes                        avec --ban : bannir sans question"
msgstr "  --yes                        with --ban: ban without asking"

