msgid "Usage : sync-crowdsec-blocklist.sh [OPTION]..."
msgstr "Usage: sync-crowdsec-blocklist.sh [OPTION]..."

msgid "Importe la liste communautaire de CrowdSec dans deux ipsets (IPv4, IPv6) bloqués au pare-feu."
msgstr "Imports the CrowdSec community list into two ipsets (IPv4, IPv6) blocked at the firewall."

msgid "Options (par ordre alphabétique) :"
msgstr "Options (in alphabetical order):"

msgid "  --blocked                    IP de la liste effectivement bloquées (compteurs du pare-feu)"
msgstr "  --blocked                    list IPs actually blocked (firewall counters)"

msgid "  --changelog                  affiche le journal des modifications"
msgstr "  --changelog                  show the change log"

msgid "  -c, --config FILE            fichier de configuration à lire SEUL (sinon : /etc/default/sync-crowdsec-blocklist.conf, puis ~/.sync-crowdsec-blocklist.conf ;"
msgstr "  -c, --config FILE            configuration file to read ALONE (otherwise: /etc/default/sync-crowdsec-blocklist.conf, then ~/.sync-crowdsec-blocklist.conf;"

msgid "                               clés : CRON_HOURS, LANGUAGE, MAX_DROP, MIN_IPS, SOURCE, STALE_DAYS, TOP, VERBOSE)"
msgstr "                               keys: CRON_HOURS, LANGUAGE, MAX_DROP, MIN_IPS, SOURCE, STALE_DAYS, TOP, VERBOSE)"

msgid "  --cron-hours N               avec --install-cron : intervalle en heures"
msgstr "  --cron-hours N               with --install-cron: interval in hours"

msgid "  --dry-run                    télécharger et analyser la liste, sans rien modifier"
msgstr "  --dry-run                    download and analyse the list, change nothing"

msgid "  -h, --help                   affiche cette aide et quitte"
msgstr "  -h, --help                   show this help and exit"

msgid "  --install-cron               synchronisation automatique (fichier cron)"
msgstr "  --install-cron               automatic synchronisation (cron file)"

msgid "  --lang LANG                  langue d'affichage : en ou fr (défaut : selon LC_ALL / LC_MESSAGES / LANG)"
msgstr "  --lang LANG                  display language: en or fr (default: from LC_ALL / LC_MESSAGES / LANG)"

msgid "  --min-ips N                  taille minimale acceptée de la liste (protection contre une liste tronquée)"
msgstr "  --min-ips N                  minimum accepted list size (protection against a truncated list)"

msgid "  --report-err                 afficher à la fin un rapport d'erreurs à copier-coller (programme, version, serveur,"
msgstr "  --report-err                 print at the end an error report to copy and paste (program, version, server,"

