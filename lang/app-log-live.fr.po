msgid "STATUS"
msgstr "ÉTAT"

msgid "SQLi attacks"
msgstr "attaques SQLi"

msgid "banned"
msgstr "bannies"

msgid "since the last detailed report (Ctrl-T or g)"
msgstr "depuis le dernier rapport détaillé (Ctrl-T ou g)"

msgid "Status bar: counters reset (new period from now)."
msgstr "Barre d'état : compteurs remis à zéro (nouvelle période à partir de maintenant)."

