msgstr "Lignes à imprimer (1 à {n}, Entrée = toutes) : "

msgid "File (Enter = {name}): "
msgstr "Fichier (Entrée = {name}) : "

msgid "Print failed: {error}"
msgstr "Impression impossible : {error}"

msgid "{n} line(s) written to {path} (colors kept: less -R {path}; mode 600, names and addresses inside)"
msgstr "{n} ligne(s) écrite(s) dans {path} (couleurs conservées : less -R {path} ; mode 600, contient des noms et des adresses)"

msgid "Last displayed lines kept in memory for the f key (displayed again with the current options) and the P key (printed to a file): 0 = none (default: 200)"
msgstr "Dernières lignes affichées gardées en mémoire pour la touche f (affichées de nouveau avec les options courantes) et la touche P (imprimées dans un fichier) : 0 = aucune (défaut : 200)"

msgid "Status bar in reverse video after every N displayed lines: SQL injection attempts, 4xx, 5xx, banned addresses, slow requests since the last detailed report (Ctrl-T or g); 0 = never (default: 100)"
msgstr "Barre d'état en vidéo inverse après toutes les N lignes affichées : tentatives d'injection SQL, 4xx, 5xx, adresses bannies, requêtes lentes depuis le dernier rapport détaillé (Ctrl-T ou g) ; 0 = jamais (défaut : 100)"

msgid "top IP"
msgstr "IP principales"

msgid "hidden (--show-ip)"
msgstr "masquées (--show-ip)"

msgid "ALERT: the status bar turned red, investigate now (Ctrl-T or g to acknowledge)"
msgstr "ALERTE : la barre d'état est passée au rouge, investiguer maintenant (Ctrl-T ou g pour acquitter)"
