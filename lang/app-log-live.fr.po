# 1.112: --since, --until, --utc, --grep, --country, --exclude-country, -f, --no-pager, --no-hostname

msgid "Show only the lines whose first address is in these countries (two-letter codes such as CA,FR; repeatable). Lines without address are hidden"
msgstr "N'affiche que les lignes dont la première adresse est dans ces pays (codes à deux lettres, par exemple CA,FR ; répétable). Les lignes sans adresse sont cachées"

msgid "Hide the lines whose first address is in these countries (two-letter codes such as US,CN; repeatable). Addresses of unknown country are kept"
msgstr "Cache les lignes dont la première adresse est dans ces pays (codes à deux lettres, par exemple US,CN ; répétable). Les adresses de pays inconnu sont gardées"

msgid "Accepted for journalctl compatibility: the live stream is the default (use --no-follow to stop after the history)"
msgstr "Accepté par compatibilité avec journalctl : le direct est le défaut (utiliser --no-follow pour s'arrêter après l'historique)"

msgid "Show only the lines whose message matches this regular expression. Case-insensitive unless REGEX has an uppercase letter (as journalctl)"
msgstr "N'affiche que les lignes dont le message correspond à cette expression régulière. Sans distinction de casse, sauf si REGEX contient une majuscule (comme journalctl)"

msgid "Do not show the host name of the journal lines (as journalctl --no-hostname)"
msgstr "N'affiche pas le nom de l'hôte des lignes du journal (comme journalctl --no-hostname)"

msgid "Accepted for journalctl compatibility: the output is never paged"
msgstr "Accepté par compatibilité avec journalctl : la sortie n'est jamais paginée"

msgid "Show the lines from TIME: YYYY-MM-DD [HH:MM[:SS]] [Z or +HH:MM], HH:MM[:SS] (today), today, yesterday, @EPOCH, now, or relative (-2h, '-30 min', '0.5 day', '3 days ago'). Local time, or UTC with --utc"
msgstr "Affiche les lignes à partir de TEMPS : AAAA-MM-JJ [HH:MM[:SS]] [Z ou +HH:MM], HH:MM[:SS] (aujourd'hui), today, yesterday, @EPOCH, now, ou relatif (-2h, '-30 min', '0.5 day', '3 days ago'). Heure locale, ou UTC avec --utc"

msgid "Show only the lines BEFORE TIME (same formats as --since); a date alone includes the whole day. With the live stream, the program stops at that time"
msgstr "N'affiche que les lignes AVANT TEMPS (mêmes formats que --since) ; une date seule inclut toute la journée. En direct, le programme s'arrête à ce moment"

msgid "Times in UTC: the time of each line, and the times given to --since / --until without a time zone (default: local time)"
msgstr "Heures en UTC : l'heure de chaque ligne, et les heures données à --since / --until sans fuseau (défaut : heure locale)"

msgid "Days of sign-in history read from the log, fractions allowed: 0.1 = 2.4 hours (default: 0 = the whole history of the log)"
msgstr "Jours d'historique des connexions lus dans le journal, fractions permises : 0.1 = 2,4 heures (défaut : 0 = tout l'historique du journal)"

msgid "Filters (--since, --until, --grep, --country, --exclude-country): {filters}"
msgstr "Filtres (--since, --until, --grep, --country, --exclude-country) : {filters}"

msgid "from"
msgstr "depuis"

msgid "before"
msgstr "avant"

msgid "country"
msgstr "pays"

msgid "not country"
msgstr "pas le pays"

