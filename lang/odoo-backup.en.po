msgstr "#KEEP_DAILY=7                      # then: the last one of each day for N days,"

msgid "#KEEP_WEEKLY=4                     #           la dernière de chaque semaine pendant N semaines,"
msgstr "#KEEP_WEEKLY=4                     #       the last one of each week for N weeks,"

msgid "#KEEP_MONTHLY=6                    #           la dernière de chaque mois pendant N mois"
msgstr "#KEEP_MONTHLY=6                    #       the last one of each month for N months"

msgid "#TIMER_TIME=02:30                  # heure(s) de la sauvegarde automatique, une ou plusieurs : TIMER_TIME=09:00 16:00 23:00"
msgstr "#TIMER_TIME=02:30                  # time(s) of the automatic backup, one or more: TIMER_TIME=09:00 16:00 23:00"

