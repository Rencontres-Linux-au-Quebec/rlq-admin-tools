msgid "  REMOTE=                       copie rsync facultative, ex. root@serveur-de-sauvegarde.exemple:/srv/sauvegardes/odoo"
msgstr "  REMOTE=                       optional rsync copy, e.g. root@backup-server.example:/srv/backups/odoo"

