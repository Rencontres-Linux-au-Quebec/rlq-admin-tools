msgstr "Odoo injoignable depuis nginx : {n} fois"

msgid "Other messages of the nginx error log: {n}"
msgstr "Autres messages du journal d'erreurs de nginx : {n}"

msgid "{n} answers 404 on {url}, a page listed in sitemap.xml"
msgstr "{n} réponses 404 sur {url}, une page listée dans sitemap.xml"

msgid "nothing to fix; optional: a 301 redirect from this address to /sitemap.xml (Website > Configuration > Redirects)"
msgstr "rien à corriger ; facultatif : une redirection 301 de cette adresse vers /sitemap.xml (Site Web > Configuration > Redirections)"

msgid "correct the link in the page that holds it (Linked from the site itself)"
msgstr "corriger le lien dans la page qui le contient (Lien depuis le site lui-même)"

msgid "Exceptions of all the occurrences: "
msgstr "Exceptions de toutes les occurrences : "

msgid "Exception of the last occurrence: "
msgstr "Exception de la dernière occurrence : "

msgid "an exception in the module named above, while handling a request"
msgstr "une exception dans le module nommé ci-dessus, pendant le traitement d'une requête"

msgid "Failed e-mails (journal): {n}"
msgstr "Courriels en échec (journal) : {n}"

msgid "Database not read (run with sudo): the count comes from the journal lines only"
msgstr "Base de données non lue (lancer avec sudo) : le nombre vient seulement des lignes du journal"

msgid "E-mails waiting to be sent: {n}"
msgstr "Courriels en attente d'envoi : {n}"

msgid "Time in SQL {sql} %, outside SQL {py} % (Python computation, templates, waiting for a lock or for the processor)"
msgstr "Temps dans SQL {sql} %, hors SQL {py} % (calcul Python, gabarits, attente d'un verrou ou du processeur)"

msgid "Busiest hours: "
msgstr "Heures les plus chargées : "

msgid "{k} of them in the 10 minutes after a start of Odoo ({r} starts in the window)"
msgstr "{k} d'entre elles dans les 10 minutes après un démarrage d'Odoo ({r} démarrages dans la période)"

msgid "odoo.conf not read (run with sudo): workers, limit_time_cpu and limit_time_real not checked"
msgstr "odoo.conf non lu (lancer avec sudo) : workers, limit_time_cpu et limit_time_real non vérifiés"

msgid "Forms sent (POST): {posts} · pages only shown (GET): {gets}"
msgstr "Formulaires envoyés (POST) : {posts} · pages seulement affichées (GET) : {gets}"

msgid "Sign-up and password reset forms: {n} requests, almost all only shown"
msgstr "Formulaires d'inscription et de mot de passe oublié : {n} requêtes, presque toutes seulement affichées"

msgid "look at the portal accounts created recently (Settings > Users, filter « Portal »): remove the fake ones"
msgstr "regarder les comptes portail créés récemment (Configuration > Utilisateurs, filtre « Portail ») : supprimer les faux"

msgid "In Odoo: no event with the number {id} (deleted)"
msgstr "Dans Odoo : aucun événement portant le numéro {id} (supprimé)"

msgid "In Odoo: no product with the number {id} (deleted)"
msgstr "Dans Odoo : aucun produit portant le numéro {id} (supprimé)"

msgid "In Odoo: event n° {id} « {title} »"
msgstr "Dans Odoo : événement n° {id} « {title} »"

msgid "In Odoo: product n° {id} « {title} »"
msgstr "Dans Odoo : produit n° {id} « {title} »"

msgid "In Odoo: web page {url}"
msgstr "Dans Odoo : page web {url}"

msgid "In Odoo: no web page at this address"
msgstr "Dans Odoo : aucune page web à cette adresse"

msgid "published"
msgstr "publié"

msgid "NOT published"
msgstr "NON publié"

msgid "archived"
msgstr "archivé"

msgid "a form of the site fails for its visitors: test it yourself, the visitors' data is lost at each error"
msgstr "un formulaire du site échoue pour ses visiteurs : le tester soi-même, les données des visiteurs sont perdues à chaque erreur"

msgid "From {first} to {last}"
msgstr "Du {first} au {last}"

msgid "Service now: {svc}"
msgstr "Service maintenant : {svc}"

msgid "{n} answers 404 on {url} (sitemap page), but it answers 200 now"
msgstr "{n} réponses 404 sur {url} (page du sitemap), mais elle répond 200 maintenant"

msgid "{n} answers 404 on {url}: a WordPress sitemap name"
msgstr "{n} réponses 404 sur {url} : un nom de plan du site de WordPress"

msgid "{n} answers 404 on {url}, but it answers 200 now"
msgstr "{n} réponses 404 sur {url}, mais elle répond 200 maintenant"

msgid "{k} variants of the message (numbers or versions differ)"
msgstr "{k} variantes du message (les nombres ou les versions diffèrent)"

msgid "the slowest: {s} s"
msgstr "la plus lente : {s} s"

msgid "Machine: {cpus} processors, {mem} MB of memory"
msgstr "Machine : {cpus} processeurs, {mem} Mo de mémoire"

msgid "Sign-up in Odoo: {scope}"
msgstr "Inscription dans Odoo : {scope}"

msgid "Sign-up in Odoo: free (anyone can create an account)"
msgstr "Inscription dans Odoo : libre (n'importe qui peut créer un compte)"

msgid "Sign-up in Odoo: on invitation"
msgstr "Inscription dans Odoo : sur invitation"

msgid "last on {when}"
msgstr "dernière le {when}"

msgid "All the occurrences read end with the same exception ({k})"
msgstr "Toutes les occurrences lues finissent par la même exception ({k})"

msgid "Settings read in "
msgstr "Réglages lus dans "

msgid "workers=0: Odoo runs in ONE process (threads): a slow request holds the others, and limit_time_* do not apply; set workers to {best} at most for this processor count (the memory allows about {mem} workers)"
msgstr "workers=0 : Odoo tourne dans UN seul processus (fils) : une requête lente retient les autres, et limit_time_* ne s'appliquent pas ; régler workers à {best} au plus pour ce nombre de processeurs (la mémoire permet environ {mem} workers)"

msgid "update the module {module}, or report the exception to its author with the traceback (key E)"
msgstr "mettre à jour le module {module}, ou signaler l'exception à son auteur avec la trace (touche E)"

msgid "workers={now} is more than (2 x CPU) + 1 = {best}: the workers fight for the processor and each request gets slower; lower workers to {best}"
msgstr "workers={now} dépasse (2 x CPU) + 1 = {best} : les workers se disputent le processeur et chaque requête ralentit ; baisser workers à {best}"

msgid "… and {n} more"
msgstr "… et {n} autres"

msgid "portal accounts created in the window: {n}"
msgstr "comptes portail créés dans la période : {n}"

msgid "Key stored in Odoo: written on {when}"
msgstr "Clé enregistrée dans Odoo : écrite le {when}"

msgid "workers={now} for this machine: up to {best} workers are possible (Odoo guide: (2 x CPU) + 1, about 325 MB each)"
msgstr "workers={now} pour cette machine : jusqu'à {best} workers sont possibles (guide d'Odoo : (2 x CPU) + 1, environ 325 Mo chacun)"

msgid "ended on {end}"
msgstr "terminé le {end}"

msgid "the workers may need about {need} MB, close to the {mem} MB of the machine: add memory or lower workers"
msgstr "les workers peuvent demander environ {need} Mo, près des {mem} Mo de la machine : ajouter de la mémoire ou baisser workers"

msgid "similar pages: "
msgstr "pages semblables : "

msgid "the slowest request took {s} s, close to limit_time_real={limit} s: beyond it, Odoo stops the request (the visitor gets an error)"
msgstr "la requête la plus lente a pris {s} s, près de limit_time_real={limit} s : au-delà, Odoo arrête la requête (le visiteur reçoit une erreur)"

msgid "a browser registered for push notifications with a VAPID public key different from the one stored in Odoo (ir.config_parameter mail.web_push_vapid_public_key): usually after a database restore or copy, or a regenerated key"
msgstr "un navigateur s'est abonné aux notifications avec une clé publique VAPID différente de celle enregistrée dans Odoo (ir.config_parameter mail.web_push_vapid_public_key) : habituellement après une restauration ou une copie de la base, ou une clé régénérée"

msgid "harmless for the site: only the push notifications of these browsers fail; nothing to fix if the key was changed on purpose, the browsers subscribe again when their site data is cleared"
msgstr "sans gravité pour le site : seules les notifications de ces navigateurs échouent ; rien à corriger si la clé a été changée volontairement, les navigateurs se réabonnent quand leurs données du site sont effacées"

# 1.4
msgid "the slowest request took {s} s, more than limit_time_real={limit} s: Odoo stops such a request (the visitor gets an error), unless it is a long connection (websocket)"
msgstr "la requête la plus lente a pris {s} s, plus que limit_time_real={limit} s : Odoo arrête une telle requête (le visiteur reçoit une erreur), sauf une connexion longue (websocket)"
