# Traduction en en des messages de odoo-update-module.sh (msgid = fragment français du code, msgstr = traduction).
# Format PO standard : Poedit, Weblate, Crowdin… Un msgstr vide = non traduit ; identique au msgid = valable dans les deux langues.
# Les fragments sont des morceaux de phrases : garder les espaces de début et de fin, et l'ordre des morceaux.
msgid ""
msgstr ""
"Project-Id-Version: odoo-update-module.sh\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Usage : odoo-update-module.sh [OPTION]...   (sans option : mettre à jour les modules rlq_* de la base du service, puis redémarrer)"
msgstr "Usage : odoo-update-module.sh [OPTION]...   (no option: update the rlq_* modules of the service's database, then restart)"

msgid "Options (par ordre alphabétique) :"
msgstr "Options (in alphabetical order):"

msgid "  --backup                     sauvegarder la base avant (odoo-backup.sh --db BASE) ; échec = abandon, rien n'est arrêté"
msgstr "  --backup                     back up the database first (odoo-backup.sh --db DB); failure = abort, nothing is stopped"

msgid "  --changelog                  affiche le journal des modifications"
msgstr "  --changelog                  show the change log"

msgid "  -c, --config FILE            ce fichier de configuration SEUL (défaut : /etc/default/odoo-update-module.conf, puis"
msgstr "  -c, --config FILE            this configuration file ONLY (default: /etc/default/odoo-update-module.conf, then"

msgid "                               ~/.odoo-update-module.conf s'il existe ; la ligne de commande est prioritaire)"
msgstr "                               ~/.odoo-update-module.conf if it exists; the command line has priority)"

msgid "  --db NAME                    base à mettre à jour (défaut : « -d » de la commande du service, sinon db_name d'Odoo)"
msgstr "  --db NAME                    database to update (default: the « -d » of the service command, else Odoo's db_name)"

msgid "  --dry-run                    montrer ce qui serait fait (service, base, modules, commandes), sans rien arrêter ni écrire"
msgstr "  --dry-run                    show what would be done (service, database, modules, commands), without stopping or writing anything"

msgid "  --force                      continuer malgré un Odoo lancé à la main (il est alors ignoré, pas arrêté)"
msgstr "  --force                      carry on despite an Odoo started by hand (it is then ignored, not stopped)"

msgid "  -h, --help                   affiche cette aide et quitte"
msgstr "  -h, --help                   show this help and quit"

msgid "  --lang LANG                  langue d'affichage : en ou fr (défaut : LANGUAGE du fichier de configuration, sinon LC_ALL / LC_MESSAGES / LANG)"
msgstr "  --lang LANG                  display language: en or fr (default: LANGUAGE of the configuration file, else LC_ALL / LC_MESSAGES / LANG)"

msgid "  --module PATTERN             module à mettre à jour ; motif accepté (« rlq_* »), option répétable (défaut : MODULES, soit rlq_*)"
msgstr "  --module PATTERN             module to update; pattern accepted (« rlq_* »), repeatable option (default: MODULES, i.e. rlq_*)"

msgid "  --odoo-conf FILE             configuration d'Odoo (défaut : ODOO_CONF, sinon config.conf du dossier du service, sinon emplacements connus)"
msgstr "  --odoo-conf FILE             Odoo configuration (default: ODOO_CONF, else config.conf of the service folder, else known locations)"

msgid "  --report-err                 afficher à la fin un rapport d'erreurs à copier-coller (programme, version, serveur,"
msgstr "  --report-err                 show an error report to copy-paste at the end (program, version, server,"

msgid "                               échecs, avertissements) ; désactive couleurs et questions interactives"
msgstr "                               failures, warnings); disables colours and interactive questions"

msgid "  --service NAME               service systemd d'Odoo (défaut : SERVICE, sinon détection automatique : erplibre* ou odoo*)"
msgstr "  --service NAME               Odoo systemd service (default: SERVICE, otherwise auto-detected: erplibre* or odoo*)"

msgid "  --timeout SECONDS            durée maximale de la mise à jour (défaut : TIMEOUT, soit 1800)"
msgstr "  --timeout SECONDS            maximum duration of the update (default: TIMEOUT, i.e. 1800)"

msgid "  --user NAME                  compte sous lequel la mise à jour s'exécute (défaut : User= du service)"
msgstr "  --user NAME                  account the update runs under (default: User= of the service)"

msgid "  -v, --verbose                afficher chaque commande externe exécutée (systemctl, runuser, odoo, ss)"
msgstr "  -v, --verbose                show every external command run (systemctl, runuser, odoo, ss)"

msgid "  --version                    affiche la version et quitte"
msgstr "  --version                    show the version and quit"

msgid "Configuration (/etc/default/odoo-update-module.conf, créée au premier lancement, PUIS ~/.odoo-update-module.conf s'il existe ; lue sans être"
msgstr "Configuration (/etc/default/odoo-update-module.conf, created on first run, THEN ~/.odoo-update-module.conf if it exists; read without being"

msgid "exécutée ; la ligne de commande l'emporte sur les fichiers) :"
msgstr "executed; the command line overrides the files):"

msgid "  BACKUP=non                    sauvegarder avant (oui / non)"
msgstr "  BACKUP=non                    back up first (oui / non)"

msgid "  COMMAND=                      commande d'Odoo (vide : ./odoo_bin.sh du dossier du service, sinon odoo-bin)"
msgstr "  COMMAND=                      Odoo command (empty: ./odoo_bin.sh of the service folder, else odoo-bin)"

msgid "  DATABASE=                     base (vide : « -d » du service, sinon db_name d'Odoo)"
msgstr "  DATABASE=                     database (empty: the « -d » of the service, else Odoo's db_name)"

msgid "  LANGUAGE=auto                 langue d'affichage : en, fr ou auto (suivre LC_ALL / LANG)"
msgstr "  LANGUAGE=auto                 display language: en, fr or auto (follow LC_ALL / LANG)"

msgid "  MODULES=rlq_*                 modules à mettre à jour, séparés par des espaces (motifs acceptés)"
msgstr "  MODULES=rlq_*                 modules to update, separated by spaces (patterns accepted)"

msgid "  ODOO_CONF=                    configuration d'Odoo (vide : config.conf du dossier du service, sinon emplacements connus)"
msgstr "  ODOO_CONF=                    Odoo configuration (empty: config.conf of the service folder, else known locations)"

msgid "  ODOO_DIR=                     dossier d'Odoo (vide : WorkingDirectory= du service)"
msgstr "  ODOO_DIR=                     Odoo folder (empty: WorkingDirectory= of the service)"

msgid "  RUN_USER=                     compte de la mise à jour (vide : User= du service)"
msgstr "  RUN_USER=                     account of the update (empty: User= of the service)"

msgid "  SERVICE=                      service systemd d'Odoo (vide : détection automatique parmi erplibre* et odoo*, sinon erplibre_erplibre.service)"
msgstr "  SERVICE=                      Odoo systemd service (empty: auto-detected among erplibre* and odoo*, otherwise erplibre_erplibre.service)"

msgid "  TIMEOUT=1800                  durée maximale de la mise à jour, en secondes"
msgstr "  TIMEOUT=1800                  maximum duration of the update, in seconds"

msgid "  WAIT=90                       attente maximale du démarrage (service actif, puis port à l'écoute), en secondes"
msgstr "  WAIT=90                       maximum wait for startup (service active, then port listening), in seconds"

