msgstr "for n in noms:"

msgid "        couleur, mot, texte = e[\"CC\"], \"nouveau\", f\"{b or '?'}\""
msgstr "        couleur, mot, texte = e[\"CC\"], \"nouveau\", f\"{b or '?'}\""

msgid "        couleur, mot, texte = e[\"CG\"], \"mis à jour\", f\"{a or '?'} → {b or '?'}\""
msgstr "        couleur, mot, texte = e[\"CG\"], \"mis à jour\", f\"{a or '?'} → {b or '?'}\""

msgid "        couleur, mot, texte = e[\"CD\"], \"inchangé\", f\"{b or '?'}\""
msgstr "        couleur, mot, texte = e[\"CD\"], \"inchangé\", f\"{b or '?'}\""

msgid "        couleur, mot, texte = e[\"CD\"], \"\", f\"{b or '?'}\""
msgstr "        couleur, mot, texte = e[\"CD\"], \"\", f\"{b or '?'}\""

msgid "    print(f\"      {e['CB']}{n.ljust(largeur)}{e['CR']}  {texte.ljust(34)} {couleur}{(f\"({mot})\" if mot else \"\").ljust(13)}{e['CR']} {e['CD']}{locale(apres[n]['maj'])}{e['CR']}\")"
msgstr "    print(f\"      {e['CB']}{n.ljust(largeur)}{e['CR']}  {texte.ljust(34)} {couleur}{(f\"({mot})\" if mot else \"\").ljust(13)}{e['CR']} {e['CD']}{locale(apres[n]['maj'])}{e['CR']}\")"

