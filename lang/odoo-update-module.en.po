msgid "print(f\"  {e['CD']}Versions des modules installés (base {e['BASE']}) — Odoo {e['CR']}{e['CC']}{vb}{e['CR']}\" + (f\"{e['CD']} (avant : {va}){e['CR']}\" if va != vb else \"\"))"
msgstr "print(f\"  {e['CD']}Versions des modules installés (base {e['BASE']}) — Odoo {e['CR']}{e['CC']}{vb}{e['CR']}\" + (f\"{e['CD']} (avant : {va}){e['CR']}\" if va != vb else \"\"))"

msgid "largeur = max((len(n) for n in noms), default=0)"
msgstr "largeur = max((len(n) for n in noms), default=0)"

