msgid " guests checked for their start with the host, their backups (every disk and mount point) and their disk cache"
msgstr " invités vérifiés pour leur démarrage avec l'hôte, leurs sauvegardes (chaque disque et point de montage) et le cache de leurs disques"

msgid "COMMANDS — [read]: run by the program, output below · [change]: run only after your confirmation"
msgstr "COMMANDES — [lecture] : lancées par le programme, sortie plus bas · [modif.] : lancées seulement après votre confirmation"

msgid "COLLECTED — output of the [read] commands (send it with this report)"
msgstr "COLLECTÉ — sortie des commandes [lecture] (à envoyer avec ce rapport)"

msgid "CHANGES — "
msgstr "CHANGEMENTS — "

msgid " commands that modify something; each one is run only if you answer « y »"
msgstr " commandes qui modifient quelque chose ; chacune n'est lancée que si vous répondez « y »"

msgid "Only list the commands at the end: do not run the read-only ones and do not offer the changes"
msgstr "Seulement lister les commandes à la fin : ne pas lancer celles en lecture seule et ne pas proposer les changements"

msgid " commands not run: no terminal to confirm them (run them by hand, see [change] above)"
msgstr " commandes non lancées : aucun terminal pour les confirmer (à lancer à la main, voir [modif.] plus haut)"

msgid " commands not run: root required"
msgstr " commandes non lancées : root requis"

msgid "  not run"
msgstr "  non lancée"

msgid " exit code "
msgstr " code de sortie "

msgid "   (exit code "
msgstr "   (code de sortie "

msgid "  Run it? [y/N]: "
msgstr "  La lancer ? [y/N] : "

msgid "\n  Remaining changes not run."
msgstr "\n  Changements restants non lancés."

msgid "(no output)"
msgstr "(aucune sortie)"

msgid " failed — normal in a container: it cannot set the clock, the host keeps the time; disable it"
msgstr " en échec — normal dans un conteneur : il ne peut pas régler l'horloge, l'hôte garde l'heure ; le désactiver"

msgid " backups under "
msgstr " sauvegardes sous "

msgid " but Proxmox sees "
msgstr " mais Proxmox en voit "

msgid " are in a sub-folder ("
msgstr " sont dans un sous-dossier ("

