msgstr "non lancée : le temps prévu pour la collecte est écoulé"

msgid " rm -v --   # deletes the files of the list: irreversible, copy elsewhere first what must be kept"
msgstr " rm -v --   # supprime les fichiers de la liste : irréversible, copier d'abord ailleurs ce qui doit être gardé"

msgid ",discard=on   # applied at the next stop and start of the VM"
msgstr ",discard=on   # appliqué au prochain arrêt et démarrage de la VM"

msgid " -- fstrim -av   # after that start: gives back to the pool the room already freed in the VM"
msgstr " -- fstrim -av   # après ce démarrage : rend au pool la place déjà libérée dans la VM"

msgid "[read]  "
msgstr "[lecture]"

msgid "[change]"
msgstr "[modif.] "

msgid ") and no task of it is running — a backup or a snapshot was interrupted; backups and changes are refused while it stays"
msgstr ") et aucune tâche de cet invité ne tourne — une sauvegarde ou un instantané a été interrompu ; les sauvegardes et les changements sont refusés tant qu'il reste"

msgid ") by a task running now ("
msgstr ") par une tâche en cours ("

