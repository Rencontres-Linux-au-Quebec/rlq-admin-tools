# Traduction en en des messages de ../nginx-tools-tests/run-all.sh (msgid = fragment français du code, msgstr = traduction).
# Format PO standard : Poedit, Weblate, Crowdin… Un msgstr vide = non traduit ; identique au msgid = valable dans les deux langues.
# Les fragments sont des morceaux de phrases : garder les espaces de début et de fin, et l'ordre des morceaux.
msgid ""
msgstr ""
"Project-Id-Version: ../nginx-tools-tests/run-all.sh\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "*** ARRÊT INATTENDU DE run-all.sh (code "
msgstr "*** UNEXPECTED STOP OF run-all.sh (code "

msgid ") À LA LIGNE "
msgstr ") AT LINE "

msgid "--app attend un nom (odoo, bbb…)"
msgstr "--app expects a name (odoo, bbb…)"

msgid "Changelog introuvable : "
msgstr "Changelog not found: "

msgid "Usage : nginx-tools-tests/run-all.sh [OPTION]..."
msgstr "Usage: nginx-tools-tests/run-all.sh [OPTION]..."

msgid "Suite de validation : présence des programmes, syntaxe, ShellCheck, ruff, tests (un passage par awk), configuration."
msgstr "Validation suite: presence of the programs, syntax, ShellCheck, ruff, tests (one pass per awk), configuration."

msgid "Options (par ordre alphabétique) :"
msgstr "Options (in alphabetical order):"

msgid "  --all-environments           exécuter les tests de TOUS les environnements (Odoo et BigBlueButton), quel que soit le serveur"
msgstr "  --all-environments           run the tests of ALL environments (Odoo and BigBlueButton), whatever the server"

msgid "  --app NAME                   environnement à tester : odoo, bbb… (profil apps/NAME.conf ; défaut : détecté sur ce serveur)"
msgstr "  --app NAME                   environment to test: odoo, bbb… (profile apps/NAME.conf; default: detected on this server)"

msgid "  -c, --config FILE            fichier de configuration à lire SEUL (défaut : /etc/default/run-all.conf puis ~/.run-all.cfg)"
msgstr "  -c, --config FILE            configuration file to read ALONE (default: /etc/default/run-all.conf then ~/.run-all.cfg)"

msgid "  --changelog                  affiche le journal des modifications"
msgstr "  --changelog                  show the change log"

msgid "  -h, --help                   affiche cette aide et quitte"
msgstr "  -h, --help                   show this help and exit"

msgid "  --lang LANG                  langue d'affichage : en ou fr (défaut : selon LC_ALL / LC_MESSAGES / LANG)"
msgstr "  --lang LANG                  display language: en or fr (default: from LC_ALL / LC_MESSAGES / LANG)"

msgid "  --list                       affiche l'environnement détecté et les modules de test retenus, sans rien exécuter"
msgstr "  --list                       show the detected environment and the selected test modules, running nothing"

msgid "  --report-err                 afficher à la fin un rapport d'erreurs à copier-coller (programme, version, serveur,"
msgstr "  --report-err                 print at the end an error report to copy and paste (program, version, server,"

msgid "                               échecs, avertissements) ; désactive couleurs et questions interactives"
msgstr "                               failures, warnings); disables colours and interactive questions"

msgid "  -v, --verbose                détail de chaque vérification"
msgstr "  -v, --verbose                detail of each check"

msgid "  --version                    affiche la version et quitte"
msgstr "  --version                    show the version and exit"

